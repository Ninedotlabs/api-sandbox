# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.

# --- Database -------------------------------------------------------------
# The application's own Postgres. Any Postgres works; Neon is what this was built against.
# Note that Neon auto-suspends when idle and the next connection takes several seconds.
DATABASE_URL=

# A SEPARATE database for the integration tests, which create and delete real rows.
# The test setup refuses to touch DATABASE_URL, so this must be set for those suites to run
# (they skip cleanly without it). A local container is the usual choice:
#   docker run --rm -d -p 5433:5432 -e POSTGRES_PASSWORD=postgres postgres:16-alpine
PG_TEST_DATABASE_URL=

# --- Sign-in (Auth.js v5 + Google) ----------------------------------------
# From a Google Cloud OAuth client. The redirect URI registered there must exactly match
# <your-origin>/api/auth/callback/google (e.g. http://localhost:3000/api/auth/callback/google
# in dev). Preview deployments on a new URL won't be able to sign in - see the design doc.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Signs and encrypts session-related values. Generate one with:
#   npx auth secret
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Gates the sign-in requirement for app pages (see src/proxy.ts). Defaults to OFF - leave
# it unset until a real Google sign-in has been verified end to end, per the lockout
# warning in docs/superpowers/specs/2026-09-21-google-auth-design.md. Set to "true" to
# require sign-in; anything else (including unset) leaves the app exactly as it is today.
AUTH_REQUIRED=

# --- API and MCP access ---------------------------------------------------
# Bearer token for /api/v1 and /api/mcp. Same-origin browser requests are exempt; every
# other client must send it. Treat it as a password: while sign-in is deferred, anyone
# holding it can read and modify every project. Generate one with:
#   node -e "console.log('ua_' + require('crypto').randomBytes(32).toString('base64url'))"
UNIVERSAL_API_TOKEN=

# --- AI (Generate with AI / Edit with AI) ---------------------------------
# An Azure AI Foundry deployment exposing the OpenAI-compatible Responses API.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=

# --- App origin (copyable snippets, base-URL displays) --------------------
# Optional. The origin used to build the curl/JS/Python and MCP connect snippets a person
# copies, and the base-URL pill in the UI. Leave unset in most cases: in the browser it falls
# back to that visitor's own window.location.origin (always correct, no configuration), and on
# Vercel it falls back to https://$NEXT_PUBLIC_VERCEL_URL with zero setup. Set this only to
# force a specific origin (e.g. a custom domain), as a bare host ("example.com") or a full URL
# ("https://example.com"). NEXT_PUBLIC_* variables are inlined at BUILD TIME, so changing this
# in the Vercel dashboard has no effect until the next redeploy.
NEXT_PUBLIC_APP_URL=
